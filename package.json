{
  "name": "grand-testament-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "world": "python3 -I tools/build_world.py",
    "dev": "vite",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/fetch_assets.mjs",
    "assets:prepare": "node tools/prepare_tripo.mjs",
    "build": "node tools/fetch_assets.mjs && tsc --noEmit && node --test test/*.test.ts && vite build",
    "preview": "vite preview --port 4173",
    "bench": "node tools/bench.mjs",
    "bench:all": "node tools/bench_all.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@types/node": "22.19.1",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
